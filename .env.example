# Copy to .env.local and fill in. Never commit real values.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (or the legacy "anon" key). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Secret key (or the legacy "service_role" key). Server-only. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Public base URL of this app, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key for AI creative analysis. Server-only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Optional model override. Default is claude-opus-5-5; claude-sonnet-5-5 costs about half.
ANTHROPIC_MODEL=claude-opus-5-5

# Analysis provider: "anthropic" or "fake" (deterministic, no API calls).
ANALYSIS_PROVIDER=anthropic

